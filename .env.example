# Required
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=deep_agent
VOYAGE_API_KEY=pa-...
TAVILY_API_KEY=tvly-...

# LLM provider (default: AWS Bedrock cross-region Claude Sonnet 4.6)
LLM_PROVIDER=bedrock
LLM_MODEL=global.anthropic.claude-sonnet-4-6
AWS_DEFAULT_REGION=us-east-1
# AWS creds via env or instance profile

# Voyage (asymmetric retrieval: voyage-4 for documents, voyage-4-lite for queries)
VOYAGE_DOCUMENT_MODEL=voyage-4
VOYAGE_QUERY_MODEL=voyage-4-lite
VOYAGE_DIMENSIONS=1024
VOYAGE_RERANK_MODEL=rerank-2.5
# Optional: route Voyage through a gateway (e.g. MongoDB AI Gateway)
# VOYAGE_BASE_URL=https://ai.mongodb.com/v1

# Virtual filesystem backend (s3 default; gridfs alternative)
VFS_BACKEND=s3
VFS_MAX_BYTES=52428800
# S3 fields required when VFS_BACKEND=s3 (the default)
VFS_S3_BUCKET=deep-agent-artifacts
VFS_S3_PREFIX=deep-agent
VFS_S3_REGION=us-east-1

# LangSmith
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=ls_...
LANGSMITH_PROJECT=deep_agent

# Tunables
SEMANTIC_CACHE_THRESHOLD=0.9
MAX_STEPS=32

# Optional: least-privilege URI for the data-agent tool
# DATA_AGENT_MONGODB_URI=mongodb+srv://DATAAGENT:PASS@CLUSTER.mongodb.net/

# Dev only: loosen TLS enforcement (never set in prod)
# ALLOW_INSECURE=true
